# apic - copy to .env and fill. .env is gitignored.
OPENAI_API_KEY=
FAL_KEY=
TAVILY_API_KEY=
HAI_API_KEY=
PIONEER_API_KEY=

# h Holo inference endpoint - get the real base URL from the h portal.
HAI_MODEL_URL=
HAI_MODEL_NAME=holo3-1-35b-a3b

# Pioneer SLM perception - optional overrides. A completed training-job id in
# PIONEER_MODEL swaps the base encoder for a LoRA checkpoint fine-tuned on
# apic's own labels; nothing else changes.
PIONEER_MODEL=fastino/gliner2-base-v1
PIONEER_THRESHOLD=0.6
# PIONEER_JUDGE_MODEL: a completed training-job id from `node src/pioneer-train.js train`.
# When set, verify.js judges replays with the fine-tuned encoder instead of the
# OpenAI call (which stays on standby as the fallback).
PIONEER_JUDGE_MODEL=

# targets
TARGET_URL=http://localhost:3456
TARGET_USER=apic
TARGET_PASS=apicdemo2026
